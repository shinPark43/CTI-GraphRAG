# Copy to .env and fill in. Never commit .env.

# OpenAI: text-embedding-3-large for all retrieval (matches the CTIConnect paper),
# the report-layer extraction (gpt-5.4-mini; optional, data/derived is committed)
# and the RAGAS judge.
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-large

# Answering model: the local Ollama (OpenAI-compatible; /v1 is added if omitted)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3:8b-instruct-fp16

# Local Neo4j (docker compose up -d; docker-compose.yml reads NEO4J_PASSWORD from here)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
